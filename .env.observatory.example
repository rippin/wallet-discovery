# Copy to .env.observatory on your VPS. Never commit real keys.
# Minimum 7 characters; deploy/update.sh generates and saves one if blank.
OBS_PASSWORD=
HELIUS_API_KEY=
# Optional alternative read-only RPC endpoint; overrides HELIUS_API_KEY.
OBS_RPC_URL=
# Enable after configuring your free RPC account.
OBS_LIVE=0
OBS_MONTHLY_CREDITS=900000
# Conservative reservation per RPC call. Verify your account's current costs.
OBS_RPC_CREDIT_COST=10
OBS_CYCLE_SECONDS=300
