# Copy to .env on your VPS. Never commit real keys.
# Minimum 7 characters; missing or blank defaults to password123.
OBS_PASSWORD=
HELIUS_API_KEY=
# Optional alternative read-only RPC endpoint; overrides HELIUS_API_KEY.
OBS_RPC_URL=
# Enable after configuring your free RPC account.
OBS_LIVE=0
OBS_MONTHLY_CREDITS=900000
# Conservative reservation per RPC call. Verify your account's current costs.
OBS_RPC_CREDIT_COST=10
OBS_CYCLE_SECONDS=300

# Continuous discovery: bounded work every 30 seconds.
OBS_DISCOVERY_SECONDS=30
OBS_DISCOVERY_REQUESTS=6
# Skip older queued discovery work; wallet tracking history is unaffected.
OBS_DISCOVERY_MAX_AGE_SECONDS=600
# New-wallet admission; 0 disables. Unknown market caps stay pending.
OBS_MIN_MARKET_CAP_USD=10000

# Minimum estimated USD-equivalent buy for new discovered wallets; 0 disables.
OBS_MIN_PURCHASE_USD=100

# Bounded closer observation; membership freezes for each seven-day run.
OBS_FOCUS_WALLETS=3
OBS_FOCUS_SECONDS=120
OBS_RESEARCH_SECONDS=60
# Optional Jupiter V2 quote-only checks (separate from your Solana RPC key).
JUPITER_API_KEY=
OBS_QUOTE_DAILY_CAP=100
